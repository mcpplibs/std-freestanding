import mcpp;
import std;

// mcpplibs.std.freestanding — libc++'s own headers, configured for a target
// with no OS, exported as one module.
//
// WHAT THIS PACKAGE KNOWS, AND WHAT IT DELIBERATELY DOES NOT
//
// It does not know which C library the target uses, which ISA it is, or which
// toolchain is compiling it. It asks mcpp for the toolchain's payload root and
// the target's sysroot, and both answers change with `--target` and
// `[toolchain]` without this file changing at all.
//
// An earlier version declared `xim:picolibc-riscv@1.8.12` and `xim:llvm` in
// `[xlings] deps`. That worked and was wrong three times over: it pinned a
// libc, an architecture and a standard-library implementation into a package
// whose whole content is implementation-neutral names from the standard.
//
// ⚠️ MEASURED: with the config below, 103 of libc++'s 110 headers compile for
// riscv64-none-elf. The other 7 (generator, hazard_pointer, rcu, spanstream,
// stacktrace, stdfloat, text_encoding) fail on an x86_64 host with full libc++
// and glibc too — they are headers libc++ has not implemented. The
// freestanding loss at compile time is zero.
int main() {
    const char* tc = mcpp::toolchain_dir();
    if (!tc || !*tc) {
        std::cerr << "std-freestanding: mcpp did not report a toolchain "
                     "directory; this package needs the C++ library headers "
                     "that ship with it\n";
        return 1;
    }

    // ── The synthesised __config_site ──────────────────────────────────────
    //
    // ⚠️ It has to be a FILE, not -D flags. `_LIBCPP_HAS_THREADS` and friends
    // are read from this header by <__config>; defining them on the command
    // line does not reach the check at all — measured, the obvious
    // `-D_LIBCPP_HAS_THREADS=0` has no effect whatsoever.
    //
    // Turning a capability off here makes it VANISH rather than leaving a stub
    // that fails at run time: `std::mutex` becomes "no type named 'mutex' in
    // namespace 'std'", which is the diagnostic a bare-metal author wants.
    const std::string out = mcpp::out_dir() ? mcpp::out_dir() : ".";
    const std::string cfgdir = out + "/libcxx-config/c++/v1";
    std::filesystem::create_directories(cfgdir);
    {
        std::ofstream f(cfgdir + "/__config_site");
        f << "#ifndef _LIBCPP___CONFIG_SITE\n#define _LIBCPP___CONFIG_SITE\n"
             "#define _LIBCPP_ABI_VERSION 1\n"
             "#define _LIBCPP_ABI_NAMESPACE __1\n"
             "#define _LIBCPP_ABI_FORCE_ITANIUM 0\n"
             "#define _LIBCPP_ABI_FORCE_MICROSOFT 0\n"
             // The four that make it freestanding.
             "#define _LIBCPP_HAS_THREADS 0\n"
             "#define _LIBCPP_HAS_MONOTONIC_CLOCK 0\n"
             "#define _LIBCPP_HAS_FILESYSTEM 0\n"
             "#define _LIBCPP_HAS_LOCALIZATION 0\n"
             // Consequences of the above; left on they name facilities that no
             // longer exist.
             "#define _LIBCPP_HAS_TERMINAL 0\n"
             "#define _LIBCPP_HAS_RANDOM_DEVICE 0\n"
             "#define _LIBCPP_HAS_TIME_ZONE_DATABASE 0\n"
             "#define _LIBCPP_HAS_WIDE_CHARACTERS 0\n"
             "#define _LIBCPP_HAS_UNICODE 1\n"
             "#define _LIBCPP_HAS_MUSL_LIBC 0\n"
             "#define _LIBCPP_HAS_THREAD_API_PTHREAD 0\n"
             "#define _LIBCPP_HAS_THREAD_API_EXTERNAL 0\n"
             "#define _LIBCPP_HAS_THREAD_API_WIN32 0\n"
             "#define _LIBCPP_HAS_THREAD_API_C11 0\n"
             "#define _LIBCPP_HAS_VENDOR_AVAILABILITY_ANNOTATIONS 0\n"
             "#define _LIBCPP_INSTRUMENTED_WITH_ASAN 0\n"
             // Serial, because the std::thread backend does not exist here.
             "#define _LIBCPP_PSTL_BACKEND_SERIAL\n"
             "#define _LIBCPP_HARDENING_MODE_DEFAULT 2\n"
             "#define _LIBCPP_ASSERTION_SEMANTIC_DEFAULT 2\n"
             // libc++ already knows what picolibc is; saying so is not the
             // same as depending on it — a target whose libc is newlib would
             // set the other flag, and neither is this package's choice to
             // make beyond passing it on.
             "#define _LIBCPP_LIBC_PICOLIBC 1\n"
             "#define _LIBCPP_LIBC_NEWLIB 0\n"
             "#endif\n";
    }

    // ⚠️ ORDER: the synthesised config must be found before libc++'s own
    // headers, or `<__config>` picks up the host's.
    //
    // The target's C headers are NOT listed here — mcpp already put them on
    // the compile line, because the C library belongs to the target.
    // ⚠️ THIS PACKAGE IS libc++'S FREESTANDING SUBSET, NOT THE STANDARD'S, AND
    // THE DIFFERENCE HAS TO BE SAID OUT LOUD BEFORE THE COMPILER SAYS IT BADLY.
    //
    // The freestanding subset is defined by the standard, and every
    // implementation is meant to provide one — libstdc++ and the MSVC standard
    // library included. This package provides exactly one of them: it
    // synthesises libc++'s `__config_site` with libc++'s own macros and reads
    // libc++'s headers. That is a limitation of the package, not of freestanding
    // C++, and it is worth naming as such.
    //
    // Where it bites: on Windows the LLVM payload ships clang WITHOUT libc++,
    // because clang on Windows targets the MSVC standard library. The compiler
    // is still clang and the target is still `riscv64-none-elf`, so nothing
    // about the CROSS build depends on the host — the missing piece is a
    // standard library this package knows how to read.
    //
    // Without this check the first symptom is
    //
    //     src/std_freestanding.cppm:19:10: fatal error: 'algorithm' file not found
    //
    // which names a header, points inside this package, and says nothing about
    // the standard library or about the host. A reader would look for a broken
    // include path.
    {
        const auto v1 = std::filesystem::path(tc) / "include" / "c++" / "v1";
        std::error_code ec;
        if (!std::filesystem::is_directory(v1, ec)) {
            std::cerr <<
                "std-freestanding: the resolved toolchain ships no libc++.\n"
                "\n"
                "  Looked for: " << v1.string() << "\n"
                "\n"
                "  This package is libc++'s freestanding subset. The subset itself\n"
                "  is defined by the C++ standard and every implementation provides\n"
                "  one, but this package reads libc++'s headers and synthesises\n"
                "  libc++'s configuration, so it needs that implementation present.\n"
                "\n"
                "  The usual cause is a Windows host: the LLVM payload there ships\n"
                "  clang against the MSVC standard library rather than libc++. The\n"
                "  cross-compilation itself is unaffected — the compiler and the\n"
                "  target are the same as anywhere else.\n"
                "\n"
                "  Until this package grows a second backend, build it from a host\n"
                "  whose toolchain carries libc++ (Linux and macOS both do).\n";
            return 1;
        }
    }

    mcpp::include_dir(cfgdir.c_str());
    mcpp::include_dir(std::format("{}/include/c++/v1", tc).c_str());
    mcpp::include_dir(std::format("{}/share/libc++/v1", tc).c_str());  // std/<h>.inc

    // ── The C headers, when the target has no C library ──────────────────
    //
    // ⚠️ AFTER libc++'s, and the order is the whole mechanism. libc++ ships
    // wrappers for the C headers which reach the real one with `#include_next`;
    // a directory placed BEFORE libc++'s is skipped by that search and the
    // wrapper still fails. Measured: the same shim before libc++ unlocks
    // nothing, after it unlocks 79 more headers.
    //
    // The path comes from asking mcpp where the dependency landed rather than
    // from guessing the store layout. It is present only when the `nolibc`
    // feature pulled that package, so a target that has a C library adds
    // nothing and keeps its own headers.
    if (const char* nl = mcpp::dep_dir("std-freestanding-nolibc"); nl && *nl)
        mcpp::include_dir_after(std::format("{}/include", nl).c_str());

    mcpp::rerun_if_env_changed("MCPP_TARGET_ARCH");
    return 0;
}
